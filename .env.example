# URL publique du site (balises SEO, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.sovalit.com

# Envoi des demandes du formulaire de contact (SMTP : OVH, Gmail, Brevo, Resend…)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=contact@sovalit.com
SMTP_PASS=
# Adresse qui reçoit les demandes
CONTACT_TO_EMAIL=contact@sovalit.com

# Notification WhatsApp via CallMeBot (facultatif)
# Numéro au format international, sans espaces, et clé reçue de CallMeBot
CALLMEBOT_PHONE=+33600000000
CALLMEBOT_APIKEY=
